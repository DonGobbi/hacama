PORT=4000
CORS_ORIGIN=http://localhost:3000

MONGODB_URI=mongodb://localhost:27017/hacama

JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1d

# First admin account, created automatically on startup if no users exist
SEED_ADMIN_EMAIL=admin@hacama.mw
SEED_ADMIN_PASSWORD=ChangeMe123!
SEED_ADMIN_NAME=Hacama Admin

# Google Cloud Storage
GCS_PROJECT_ID=your-gcp-project-id
GCS_BUCKET=your-bucket-name
# Path to a service account JSON key (leave empty to use Application Default Credentials)
GOOGLE_APPLICATION_CREDENTIALS=./gcs-key.json
# Set to true if the bucket uses uniform access and is publicly readable
GCS_PUBLIC_BUCKET=true
