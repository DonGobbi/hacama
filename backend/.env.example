PORT=4000
CORS_ORIGIN=http://localhost:3000

MONGODB_URI=mongodb://localhost:27017/hacama

JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1d

# First admin account, created automatically on startup if no users exist
SEED_ADMIN_EMAIL=admin@hacama.mw
SEED_ADMIN_PASSWORD=ChangeMe123!
SEED_ADMIN_NAME=Hacama Admin

# Google Cloud Storage
GCS_PROJECT_ID=hacama-web
GCS_BUCKET=hacama-web-uploads
# Auth uses impersonated ADC (org policy blocks service-account key files):
#   gcloud auth application-default login --impersonate-service-account=hacama-uploader@hacama-web.iam.gserviceaccount.com
GOOGLE_APPLICATION_CREDENTIALS=
# Bucket is private (org policy blocks public access); files are served
# via /api/media/* which redirects to short-lived signed URLs
GCS_PUBLIC_BUCKET=false

# Email notifications (Resend) — admin is emailed on new applications & enquiries
# Get a key at https://resend.com — leave empty to disable notifications
RESEND_API_KEY=
# Sender address. Free tier can only send from onboarding@resend.dev until
# you verify your own domain in Resend.
MAIL_FROM=Hacama Website <onboarding@resend.dev>
# Inbox that receives notifications (free tier: must be your Resend account email)
ADMIN_NOTIFY_EMAIL=
